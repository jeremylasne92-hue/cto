{
  "name": "@cognisphere/desktop-shell",
  "version": "0.0.1",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "dev": "tsc -w",
    "build": "tsc",
    "start": "electron ."
  },
  "dependencies": {
    "electron": "^28.0.0",
    "wait-on": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron-builder": "^24.9.1",
    "electron-devtools-installer": "^3.2.0",
    "eslint": "^8.55.0",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.cognisphere.desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    }
  }
}

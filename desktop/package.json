{
  "name": "knowledge-graph-desktop",
  "version": "2.0.0",
  "description": "Knowledge Graph Desktop Application",
  "main": "dist/electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run watch:renderer\" \"npm run watch:electron\"",
    "watch:renderer": "webpack --config webpack.renderer.config.js --watch",
    "watch:electron": "tsc --project tsconfig.electron.json --watch",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build:electron": "tsc --project tsconfig.electron.json",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "d3": "^7.8.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph": "^1.44.0",
    "react-force-graph-2d": "^1.25.4",
    "react-force-graph-3d": "^3.4.0",
    "three": "^0.159.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.159.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.0",
    "typescript": "^5.2.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  }
}

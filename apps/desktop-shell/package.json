{
  "name": "@cognisphere/desktop-shell",
  "version": "0.0.1",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "tsc && electron ."
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "electron-log": "^5.0.0",
    "tree-kill": "^1.2.2"
  },
  "build": {
    "appId": "com.cognisphere.desktop",
    "productName": "Cognisphere",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "cognisphere",
      "repo": "desktop"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "../../services/backend/dist/backend",
          "to": "backend"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "../../services/backend/dist/backend.exe",
          "to": "backend"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "extraResources": [
        {
          "from": "../../services/backend/dist/backend",
          "to": "backend"
        }
      ]
    }
  }
}
